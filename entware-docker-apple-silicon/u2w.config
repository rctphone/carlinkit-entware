# Fork's armv7-3.10 target: Cortex-A7 softfp, glibc 2.17 baseline for the 2.20 firmware.
CONFIG_TARGET_armv7_3_10=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=softfp -Os -mthumb -pipe"
# CONFIG_SOFT_FLOAT is not set
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_13=y
CONFIG_GLIBC_USE_VERSION_2_17=y
CONFIG_BINUTILS_USE_VERSION_2_34=y
CONFIG_USE_GC_SECTIONS=y
CONFIG_USE_LTO=y
CONFIG_USE_STRIP=y
CONFIG_STRIP_ARGS="--strip-unneeded"
CONFIG_IPV6=y
CONFIG_FEED_rctphone=y
CONFIG_FEED_carlinkit=y
# CONFIG_PACKAGE_opkg is not set
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SMALL_CODE=y
CONFIG_DROPBEAR_SFTPSERVER=y
# CONFIG_DROPBEAR_SCP is not set
# CONFIG_DROPBEAR_DBCLIENT is not set
# CONFIG_DROPBEAR_ZLIB is not set
# CONFIG_DROPBEAR_LEGACY_COMPAT is not set
CONFIG_PACKAGE_adbd=y
CONFIG_PACKAGE_u2w-usb-debug=y
CONFIG_PACKAGE_u2w-low-latency=y
# MFi coprocessor over TCP for LIVI's MFi Host (USB NCM only, wired CarPlay on a Mac).
CONFIG_PACKAGE_u2w-mfid=y
CONFIG_PACKAGE_hostapd=y
# Fork libopenssl provides /usr/lib/libcrypto.so.1.1 for hostapd and the CarPlay daemons;
# the image installer prunes its libssl. audit.py checks it still exports every symbol the
# vendor binaries import (vendor-imports.txt).
CONFIG_PACKAGE_libopenssl=y
# AppleCarPlay/fakeiOSDevice import ENGINE_by_id/init/finish/free/get_RSA and
# ENGINE_load_builtin_engines (CoreUtils RSA path): engine API built in, no engines.
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_ENGINE_BUILTIN=y
# CONFIG_OPENSSL_WITH_CMS is not set
# CONFIG_OPENSSL_WITH_SRP is not set
# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set
# CONFIG_OPENSSL_WITH_CHACHA_POLY1305 is not set
# Vendor-library drop-ins (same sonames): zlib 1.3.2, libusb 1.0.29, mtd-utils 2.3.0 flash_erase.
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_libusb-1.0=y
CONFIG_PACKAGE_nand-utils=y
# Vendor-daemon dependencies at the vendor paths/sonames: D-Bus 1.16 (dbus-daemon reads the
# vendor /etc/dbus-1/system.conf) with expat, Apple mDNSResponder 2881 with the Carlinkit
# interface patches, fdk-aac 0.1.6 with AppleCarPlay call-pattern fixes.
CONFIG_PACKAGE_libexpat=y
CONFIG_PACKAGE_libdbus=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_mdnsd=y
CONFIG_PACKAGE_libfdk-aac=y
# BlueZ 3.36 hcid rebuilt with the vendor delta and SDP-server fixes (vendor libbluetooth stays).
CONFIG_PACKAGE_hcid=y
# Separate packages, exported but not installed in the image (off by default). libxml2 2.13.9 is
# trimmed in build.sh setup; the image keeps vendor 2.9.2 (the new dbus-daemon uses expat;
# vendor clients only list libxml2.so.2 as NEEDED). dbus-utils/mdns-utils are test tools.
CONFIG_PACKAGE_libxml2=y
CONFIG_PACKAGE_dbus-utils=y
CONFIG_PACKAGE_mdns-utils=y
CONFIG_PACKAGE_wpa-supplicant=y
CONFIG_PACKAGE_wpa-cli=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_usbmuxd=y
CONFIG_PACKAGE_umtprd=y
