+static void iphone_adb_probe_work(struct work_struct *work)
+{
+	int ret;
+
+	mutex_lock(&adb_probe_lock);
+	if (adb_probed) {
+		mutex_unlock(&adb_probe_lock);
+		return;
+	}
+	pr_warn("adb: adbd not ready in %u ms; probing without ADB\n", ADB_WAIT_MS);
+	ret = usb_composite_probe(&zero_driver);
+	if (!ret)
+		adb_probed = true;
+	else
+		pr_err("adb_coexist: probe failed: %d\n", ret);
+	mutex_unlock(&adb_probe_lock);
+}
+
+static int iphone_ffs_ready(struct ffs_data *ffs)
+{
+	int ret;
+
+	mutex_lock(&adb_probe_lock);
+	if (adb_probed) {
+		mutex_unlock(&adb_probe_lock);
+		return 0;
+	}
+	adb_ffs_ready = true;
+	ret = usb_composite_probe(&zero_driver);
+	if (ret < 0) {
+		adb_ffs_ready = false;
+		pr_err("adb_coexist: probe failed: %d\n", ret);
+	} else {
+		adb_probed = true;
+	}
+	mutex_unlock(&adb_probe_lock);
+	return ret;
+}
+
+static void iphone_ffs_closed(struct ffs_data *ffs)
+{
+	mutex_lock(&adb_probe_lock);
+	if (adb_probed) {
+		adb_probed = false;
+		adb_ffs_ready = false;
+		usb_composite_unregister(&zero_driver);
+	}
+	mutex_unlock(&adb_probe_lock);
+}
