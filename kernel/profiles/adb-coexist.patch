+static int add_ffs(struct usb_configuration *c, int idx)
+{
+	struct usb_function *f;
+	int ret;
+
+	if (!adb_ffs_ready || !func_inst_ffs || func_ffs[idx])
+		return 0;
+	f = usb_get_function(func_inst_ffs);
+	if (IS_ERR(f)) {
+		dev_err(&c->cdev->gadget->dev, "adb: ffs function unavailable: %ld\n", PTR_ERR(f));
+		return 0;
+	}
+	ret = usb_add_function(c, f);
+	if (ret) {
+		dev_err(&c->cdev->gadget->dev, "adb: cannot add ffs to config %d: %d\n",
+			c->bConfigurationValue, ret);
+		usb_put_function(f);
+		return 0;
+	}
+	func_ffs[idx] = f;
+	dev_info(&c->cdev->gadget->dev, "adb: FunctionFS enabled in configuration %d\n",
+		 c->bConfigurationValue);
 	return 0;
 }
