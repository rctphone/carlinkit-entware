+/* Carlinkit: read back the hex string stored by write_remote_eir(),
+ * truncated like the cached names (248 characters) */
+int read_remote_eir(bdaddr_t *local, bdaddr_t *peer, char *eir)
+{
+	char filename[PATH_MAX + 1], addr[18], *str;
+	int len;
+
+	create_filename(filename, PATH_MAX, local, "eir");
 
+	ba2str(peer, addr);
+	str = textfile_get(filename, addr);
+	if (!str)
+		return -ENOENT;
+
+	len = strlen(str);
+	if (len > 248)
+		str[248] = '\0';
+	strcpy(eir, str);
+
 	free(str);
 
 	return 0;
