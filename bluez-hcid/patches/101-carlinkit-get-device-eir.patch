+
+/* Carlinkit: GetDeiceEIR (sic) returns the stored EIR of a remote device as
+ * the hex string kept in <storage>/<local>/eir. Same name, signature and
+ * errors as the vendor hcid; bluetoothDaemon calls it. */
+static DBusMessage *get_device_eir(DBusConnection *conn,
+						DBusMessage *msg, void *data)
+{
+	struct adapter *adapter = data;
+	DBusMessage *reply;
+	const char *peer_addr;
+	bdaddr_t local, peer;
+	char eir[300], *str = eir;
 
+	eir[0] = '\0';
+
+	if (!dbus_message_get_args(msg, NULL,
+				DBUS_TYPE_STRING, &peer_addr,
+				DBUS_TYPE_INVALID))
+		return invalid_args(msg);
+
+	str2ba(adapter->address, &local);
+	str2ba(peer_addr, &peer);
+
+	if (read_remote_eir(&local, &peer, eir) != 0)
+		return g_dbus_create_error(msg, ERROR_INTERFACE ".DoesNotExist",
+						"Device EIR not exsit");
+
+	reply = dbus_message_new_method_return(msg);
+	if (!reply)
+		return NULL;
+
+	dbus_message_append_args(reply, DBUS_TYPE_STRING, &str,
+					DBUS_TYPE_INVALID);
+
+	return reply;
+}
