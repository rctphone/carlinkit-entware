U2W wifi-cfg80211 profile: build the vendor RTL8822BS driver (v5.8.7) in cfg80211 mode.
- Makefile: CONFIG_IOCTL_CFG80211 + RTW_USE_CFG80211_STA_EVENT, CONFIG_80211W=y (PMF/BIP).
  The private RTL_IOCTL_HOSTAPD WEXT AP path (CONFIG_AP_MODE) is unchanged, so the vendor
  hostapd keeps working with the same 88x2bs.ko.
- ioctl_cfg80211.c: cfg80211 API updates for Linux 6.18, version-guarded:
  6.7 change_beacon(cfg80211_ap_update), 6.9 ch_switch notify without punct_bitmap,
  6.13 set_monitor_channel(ndev), 6.14 get_tx_power(link_id), 6.17 radio_idx.

--- a/drivers/net/wireless/rtl8822bs/Makefile
+++ b/drivers/net/wireless/rtl8822bs/Makefile
@@ -73,7 +73,7 @@
 CONFIG_RTW_ADAPTIVITY_EN = disable
 CONFIG_RTW_ADAPTIVITY_MODE = normal
 CONFIG_SIGNAL_SCALE_MAPPING = n
-CONFIG_80211W = n
+CONFIG_80211W = y
 CONFIG_REDUCE_TX_CPU_LOADING = n
 CONFIG_BR_EXT = n
 CONFIG_TDLS = n
@@ -2243,6 +2243,10 @@
 
 ifeq ($(CONFIG_PLATFORM_IMX6ULL), y)
 EXTRA_CFLAGS += -DCONFIG_LITTLE_ENDIAN
+# U2W wifi-cfg80211: nl80211/cfg80211 AP for hostapd 2.x (SAE, PMF). The private
+# RTL_IOCTL_HOSTAPD WEXT interface (CONFIG_AP_MODE) stays, so the vendor hostapd still works.
+EXTRA_CFLAGS += -DCONFIG_IOCTL_CFG80211
+EXTRA_CFLAGS += -DRTW_USE_CFG80211_STA_EVENT
 endif
 
