# U2W station (separate package, not in the image): nl80211, WPA2/WPA3-Personal (CONFIG_SAE and
# CONFIG_TLS=openssl come from the make command line). No AP/P2P (they would pull in the hostapd
# CarPlay hooks), no EAP/WPS; libcrypto only.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_IEEE80211AC=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_ELOOP_EPOLL=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_DEBUG_FILE=y
