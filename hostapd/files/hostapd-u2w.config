# U2W AP: nl80211, WPA2/WPA3-Personal (CONFIG_SAE and CONFIG_TLS=openssl come from the
# make command line). No EAP, RADIUS, WPS, mesh, DPP or OWE.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_INTERWORKING=y
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_NO_DUMP_STATE=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_ELOOP_EPOLL=y
# "-f /tmp/userspace.log" writes into the vendor RAM log (no syslogd runs on the unit).
CONFIG_DEBUG_FILE=y
