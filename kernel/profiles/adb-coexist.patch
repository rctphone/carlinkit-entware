+/*
+ * Hold a reference on g_iphone while adbd owns FunctionFS.  The vendor
+ * userspace runs "rmmod g_iphone" when CarPlay times out; without this
+ * reference the unload starts, tears the composite down (killing NCM and
+ * ADB on the same UDC) and then hangs.  With the reference rmmod fails
+ * with EBUSY before anything is unbound.
+ */
+static void *iphone_acquire_dev(struct ffs_dev *dev)
+{
+	if (!try_module_get(THIS_MODULE))
+		return ERR_PTR(-ENOENT);
+	return NULL;
+}
+
+static void iphone_release_dev(struct ffs_dev *dev)
+{
+	module_put(THIS_MODULE);
+}
+
+static int __init iphone_init(void)
+{
+	struct f_fs_opts *opts;
+	int ret;
+
+	INIT_DELAYED_WORK(&adb_probe_work, iphone_adb_probe_work);
+	func_inst_ffs = usb_get_function_instance("ffs");
+	if (IS_ERR(func_inst_ffs)) {
+		pr_err("adb: ffs instance unavailable: %ld\n", PTR_ERR(func_inst_ffs));
+		func_inst_ffs = NULL;
+		ret = usb_composite_probe(&zero_driver);
+		adb_probed = !ret;
+		return ret;
+	}
+	opts = to_f_fs_opts(func_inst_ffs);
+	ret = ffs_name_dev(opts->dev, "adb");
+	if (ret) {
+		pr_err("adb: cannot name ffs device: %d\n", ret);
+		usb_put_function_instance(func_inst_ffs);
+		func_inst_ffs = NULL;
+		ret = usb_composite_probe(&zero_driver);
+		adb_probed = !ret;
+		return ret;
+	}
+	opts->dev->ffs_ready_callback = iphone_ffs_ready;
+	opts->dev->ffs_closed_callback = iphone_ffs_closed;
+	opts->dev->ffs_acquire_dev_callback = iphone_acquire_dev;
+	opts->dev->ffs_release_dev_callback = iphone_release_dev;
+	opts->no_configfs = true;
+	schedule_delayed_work(&adb_probe_work, msecs_to_jiffies(ADB_WAIT_MS));
+	pr_info("adb: waiting up to %u ms for adbd descriptors\n", ADB_WAIT_MS);
+	return 0;
+}
+
 module_init(iphone_init);
