 	u32			ier;
--- a/drivers/mmc/host/sdhci.c
+++ b/drivers/mmc/host/sdhci.c
@@ -2611,15 +2611,21 @@
 	struct sdhci_host *host = mmc_priv(mmc);
 	unsigned long flags;
 
-	if (enable)
-		pm_runtime_get_noresume(mmc_dev(mmc));
-
+	/*
+	 * U2W: the SCHED_FIFO sdio_irq_thread re-enables after every interrupt
+	 * and the hard IRQ only masks, so hold one runtime PM reference while
+	 * SDIO IRQs are wanted instead of one per enable call.
+	 */
 	spin_lock_irqsave(&host->lock, flags);
+	if (enable && !host->sdio_irq_pm_ref) {
+		pm_runtime_get_noresume(mmc_dev(mmc));
+		host->sdio_irq_pm_ref = true;
+	} else if (!enable && host->sdio_irq_pm_ref) {
+		host->sdio_irq_pm_ref = false;
+		pm_runtime_put_noidle(mmc_dev(mmc));
+	}
 	sdhci_enable_sdio_irq_nolock(host, enable);
 	spin_unlock_irqrestore(&host->lock, flags);
-
-	if (!enable)
-		pm_runtime_put_noidle(mmc_dev(mmc));
 }
 EXPORT_SYMBOL_GPL(sdhci_enable_sdio_irq);
 
