@@ -4506,8 +4515,12 @@
 	    !host->ops->get_max_timeout_count)
 		mmc->max_busy_timeout = 0;
 
+	/*
+	 * U2W: SDIO card IRQs (RTL8822BS Wi-Fi RX) run in the core's SCHED_FIFO
+	 * sdio_irq_thread, as on the vendor 3.14 kernel, not in a normal-priority
+	 * system_wq worker that competes with the CarPlay daemons for the CPU.
