@@ -828,7 +832,26 @@
 	if (hci_test_bit(HCI_RAW, &di->flags))
 		return TRUE;
 
+	debug("io_security_event 0x%02x", eh->evt);
+
+	/* Carlinkit: pairing state for bluetoothDaemon, polled from
