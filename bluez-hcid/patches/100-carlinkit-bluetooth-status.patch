@@ -62,6 +62,10 @@
 
 static struct g_io_info io_data[HCI_MAX_DEV];
 
+/* Carlinkit: last HCI event seen by io_security_event(); the vendor build
+ * stores it and never reads it back. */
+static int last_security_evt = -1;
+
 static int pairing = HCID_PAIRING_MULTI;
 
