+static bool ncm_coexist = true;
+module_param(ncm_coexist, bool, S_IRUGO | S_IWUSR);
+MODULE_PARM_DESC(ncm_coexist, "Add CDC-NCM to configuration 1 and CDC-ACM to configuration 4");
+static int add_ncm(struct usb_configuration *c)
+{
+	struct usb_function_instance *fi; struct usb_function *f; int ret;
+	if (!ncm_coexist || func_ncm) return 0;
+	fi=usb_get_function_instance("ncm");
+	if (IS_ERR(fi)) { dev_err(&c->cdev->gadget->dev,"ncm: instance unavailable: %ld\n",PTR_ERR(fi)); return 0; }
+	f=usb_get_function(fi);
+	if (IS_ERR(f)) { usb_put_function_instance(fi); return 0; }
+	ret=usb_add_function(c,f);
+	if (ret) { usb_put_function(f); usb_put_function_instance(fi); return ret; }
+	func_inst_ncm=fi; func_ncm=f;
+	dev_info(&c->cdev->gadget->dev,"ncm: coexistence enabled in configuration %d\n",c->bConfigurationValue);
+	return 0;
+}
+static int add_acm(struct usb_configuration *c)
+{
+	struct usb_function_instance *fi; struct usb_function *f; int ret;
+	if (!ncm_coexist || func_acm) return 0;
+	fi=usb_get_function_instance("acm");
+	if (IS_ERR(fi)) { dev_err(&c->cdev->gadget->dev,"acm: instance unavailable: %ld\n",PTR_ERR(fi)); return 0; }
+	f=usb_get_function(fi);
+	if (IS_ERR(f)) { usb_put_function_instance(fi); return 0; }
+	ret=usb_add_function(c,f);
+	if (ret) { usb_put_function(f); usb_put_function_instance(fi); return ret; }
+	func_inst_acm=fi; func_acm=f;
+	dev_info(&c->cdev->gadget->dev,"acm: serial console enabled in configuration %d\n",c->bConfigurationValue);
+	return 0;
+}
