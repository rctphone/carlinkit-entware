+static int sdpd_append_to_pdu(sdp_buf_t *pdu, sdp_data_t *d)
+{
+	sdp_buf_t append;
+	int err;
+
+	/* One attribute of a local record: at most one SDP PDU */
+	memset(&append, 0, sizeof(sdp_buf_t));
+	append.data = malloc(USHRT_MAX);
+	if (!append.data)
+		return -1;
+	append.buf_size = USHRT_MAX;
+
+	sdp_set_attrid(&append, d->attrId);
+	sdp_gen_pdu(&append, d);
+	err = sdpd_append_to_buf(pdu, append.data, append.data_size);
+
+	free(append.data);
+
+	return err;
 }
 
+static int sdpd_gen_record_pdu(sdp_record_t *rec, sdp_buf_t *pdu)
+{
+	sdp_list_t *l;
+
+	pdu->data = malloc(USHRT_MAX);
+	if (!pdu->data)
+		return -1;
+
+	pdu->buf_size = USHRT_MAX;
+	pdu->data_size = 0;
+	memset(pdu->data, 0, pdu->buf_size);
+
+	for (l = rec->attrlist; l; l = l->next)
+		if (sdpd_append_to_pdu(pdu, l->data) < 0)
+			break;
+
+	return 0;
+}
