+/*
+ * Response building without the libbluetooth 3.36 helpers on the request
+ * path: those realloc() a full destination (the SDP response buffer is not
+ * the start of a heap block) and render each attribute into a 256-byte
+ * stack buffer. A request repeating attribute IDs or ranges could grow a
+ * response past its buffer (CVE-2019-8922). As in BlueZ 5.x the data that
+ * does not fit is dropped instead.
+ */
+static int sdpd_append_to_buf(sdp_buf_t *dst, uint8_t *data, uint32_t len)
+{
+	uint8_t *p = dst->data;
+	uint8_t dtd = *p;
+	uint32_t need = len;
+
+	if (dst->data_size == 0 && dtd == 0)
+		need += 2 * sizeof(uint8_t);
+	if (dtd != SDP_SEQ16 && dtd != SDP_SEQ32)
+		need += sizeof(uint8_t);	/* SEQ8 may become SEQ16 */
+
+	if (dst->data_size + need > dst->buf_size) {
+		error("Cannot append %u bytes to SDP response (%u of %u used)",
+				len, dst->data_size, dst->buf_size);
+		return -1;
+	}
+
+	if (dst->data_size == 0 && dtd == 0) {
+		/* create initial sequence */
+		*p = SDP_SEQ8;
+		dst->data_size += sizeof(uint8_t);
+		/* reserve space for sequence size */
+		dst->data_size += sizeof(uint8_t);
+	}
+
+	if (len)
+		memcpy(dst->data + dst->data_size, data, len);
+	dst->data_size += len;
+
+	dtd = *(uint8_t *) dst->data;
+	if (dst->data_size > UCHAR_MAX && dtd == SDP_SEQ8) {
+		short offset = sizeof(uint8_t) + sizeof(uint8_t);
+		memmove(dst->data + offset + 1, dst->data + offset,
+						dst->data_size - offset);
+		*p = SDP_SEQ16;
+		dst->data_size += 1;
+	}
+
+	dtd = *(uint8_t *) p;
+	p += sizeof(uint8_t);
+	switch (dtd) {
+	case SDP_SEQ8:
+		*(uint8_t *) p = dst->data_size - sizeof(uint8_t) - sizeof(uint8_t);
+		break;
+	case SDP_SEQ16:
+		bt_put_unaligned(htons(dst->data_size - sizeof(uint8_t) - sizeof(uint16_t)), (uint16_t *) p);
+		break;
+	case SDP_SEQ32:
+		bt_put_unaligned(htonl(dst->data_size - sizeof(uint8_t) - sizeof(uint32_t)), (uint32_t *) p);
+		break;
+	}
+
+	return 0;
+}
